{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "apps"
  ],
  "properties": {
    "hotReload":{
      "type" : "boolean"

    },
    "globalNginx": {
      "type" : "boolean"

    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "port"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 65535
          },
          "https": {
            "type": "boolean"
          },
          "customAppConfig": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "enabled",
              "path"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "on": {
      "type": "object",
      "properties": {
        "init": {
          "type": "object"
        },
        "start": {
          "type": "object"
        },
        "stop": {
          "type": "object",
          "properties": {
            "cleanNginx": {
              "type": "boolean"
            },
            "cleanHosts": {
              "type": "boolean"
            },
            "cleanConfigs": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}